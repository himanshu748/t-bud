{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "t-bud",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEPARTURE_HOLD", "class_name": "DepartureHold" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DepartureHold"] }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "ratelimits": [
    {
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "775817871",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "HOLD_RATE_LIMITER",
      "namespace_id": "775817872",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "775817873",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "t-bud",
      "database_id": "5b286f09-645d-45c4-84f8-9a7adc68d3e0",
      "migrations_dir": "migrations"
    }
  ]
}
